# ==========================================
# PR Intelligence App Environment Config
# ==========================================

# Server Settings
HOST=0.0.0.0
PORT=8000
RELOAD=true
DEBUG=false
LOG_LEVEL=info

# AI Provider API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Preferred AI Provider (auto, gemini, openai, anthropic, deepseek, ollama)
# "auto" uses the first provider with a key, in the order above. Ollama is never
# selected by "auto" (it needs no key, so it cannot be detected as configured) —
# set AI_PROVIDER=ollama to use it.
AI_PROVIDER=auto

# Model IDs per provider. Override to upgrade models without a code change.
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_MODEL=claude-sonnet-5
DEEPSEEK_MODEL=deepseek-chat
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# Outbound timeout for AI provider calls, in seconds
AI_TIMEOUT=30

# Event-driven freshness.
# Shared with GitHub's webhook config. When empty, deliveries are accepted
# WITHOUT signature verification and a warning is logged — set this before
# exposing the webhook endpoint publicly.
GITHUB_WEBHOOK_SECRET=
# Periodic reconciliation for missed webhook deliveries. 0 disables the loop.
SYNC_INTERVAL_SECONDS=0

# Environment mode: development (default) or production
# In development, API_KEY defaults to "dev-secret-key" if unset.
# In production, API_KEY is mandatory and server startup will fail if empty.
APP_ENV=development

# Shared-secret API auth.
# Required header: `X-API-Key: <key>` or `Authorization: Bearer <key>`.
# In development, defaults to "dev-secret-key". In production, set to your strong secret.
API_KEY=

# Git merge engine (real PR-to-PR conflict detection).
# Requires git >= 2.38 for `merge-tree --write-tree`.
# GITHUB_TOKEN is optional: when unset, the app falls back to `gh auth token`,
# so an existing `gh auth login` keeps working with no extra configuration.
GITHUB_TOKEN=
GIT_MIRROR_DIR=.git-mirrors
GIT_FETCH_TTL=300
GIT_MERGE_ENABLED=true
GIT_MAX_PAIRWISE_PRS=25

# CORS allowed origins: "*" or a comma-separated list.
# A specific list also enables credentialed requests; "*" cannot (browsers reject
# wildcard + credentials).
CORS_ALLOW_ORIGINS=*

# Application Defaults & Fetch Limits
PR_FETCH_LIMIT=100
DEFAULT_REPO=rpnunez/wp-ai-scheduler
DEFAULT_PR_COUNT=100
DEFAULT_ORDERBY=updated-desc
DB_PATH=pr_intelligence.db

# Protected Config / Invariants (Cannot be overridden via CLI args)
APP_ENV=production
PROTECTED_SYSTEM_ID=pr-intel-master-v1
SYSTEM_SALT=pr_intel_sec_key_2026
